# Reproducible environment for the RISC-V tournament framework: RISCOF arch
# tests (riscof + riscv gcc + icarus verilog) and the sail reference model.
# The sail_riscv_sim binary checked into framework/sail-riscv/bin is Linux
# aarch64, so build/run this image on an arm64 docker host.
#
# Build:  docker build -f Dockerfile.rvt -t rvt:latest .
# Run:    docker run --rm -v "$PWD":/workspace/rvt -w /workspace/rvt rvt:latest \
#           bash -c 'export PATH=/workspace/rvt/framework/bin:$PATH; make test CORE=tlverilog'
# (mount at /workspace/rvt: the generated toolchain wrappers hardcode it)

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git python3 python3-pip python3-venv \
        gcc-riscv64-unknown-elf iverilog device-tree-compiler \
        libgmp10 zlib1g ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages riscof==1.25.3 sandpiper-saas

ENV HOME=/tmp
RUN touch /tmp/.makerchip_accepted
